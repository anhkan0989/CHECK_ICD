{
  "name": "check-icdx",
  "framework": "vite",
  "buildCommand": "vite build",
  "installCommand": "npm install --ignore-scripts",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
